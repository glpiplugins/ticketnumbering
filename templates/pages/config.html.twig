{{ call('Html::header', header_params) }}

{% import 'components/form/fields_macros.html.twig' as fields %}

{% set icons = {'Ticket': 'ti-ticket', 'Problem': 'ti-alert-circle', 'Change': 'ti-refresh'} %}

<div class="asset mb-3">
    <div class="page-header d-print-none mb-3">
        <div class="row align-items-center g-3">
            <div class="col">
                <div class="d-flex align-items-center gap-3">
                    <span class="avatar avatar-md rounded bg-blue-lt text-blue">
                        <i class="ti ti-hash fs-2"></i>
                    </span>
                    <div>
                        <h2 class="page-title">{{ __('Ticket Numbering', 'ticketnumbering') }}</h2>
                        <div class="text-secondary">
                            {{ __('Define how the number of a newly created item is composed. Every item type is configured separately.', 'ticketnumbering') }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% if has_errors %}
        <div class="alert alert-danger" role="alert">
            <i class="ti ti-alert-triangle me-1"></i>
            {{ __('Nothing was saved. Correct the pattern marked below and save again.', 'ticketnumbering') }}
        </div>
    {% endif %}

    <form
        method="post"
        action="{{ path('/plugins/ticketnumbering/config') }}"
        id="ticketnumbering-config-form"
    >
        {% for section in sections %}
            <div class="card mb-3">
                <div class="card-header">
                    <h3 class="card-title mb-0">
                        <i class="ti {{ icons[section.itemtype]|default('ti-hash') }} me-2 text-secondary"></i>{{ section.label }}
                    </h3>
                    {% if not section.enabled %}
                        <span class="card-subtitle ms-auto badge bg-secondary-lt">
                            {{ __('Inactive', 'ticketnumbering') }}
                        </span>
                    {% endif %}
                </div>
                <div class="card-body">
                    {% if section.errors is not empty %}
                        <div class="alert alert-danger" role="alert">
                            <ul class="mb-0">
                                {% for error in section.errors %}
                                    <li>{{ error }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}

                    <div class="row">
                        <div class="col-12 col-xl-7">
                            <div class="row">
                                {{ fields.dropdownYesNo(
                                    section.enabled_key,
                                    section.enabled ? 1 : 0,
                                    __('Plugin numbering active', 'ticketnumbering'),
                                    {
                                        'full_width': true,
                                        'disabled': not can_update,
                                        'helper': __('When disabled, GLPI keeps its own continuous numbering for this item type.', 'ticketnumbering')
                                    }
                                ) }}

                                {% set pattern_hint %}
                                    <div class="form-hint mt-1">
                                        {{ __('Example, first number of the current period:', 'ticketnumbering') }}
                                        <span
                                            class="badge bg-blue-lt font-monospace"
                                            data-tn-preview="{{ section.itemtype }}"
                                        >{{ section.preview }}</span>
                                    </div>
                                {% endset %}

                                {{ fields.textField(
                                    section.pattern_key,
                                    section.pattern,
                                    __('Number pattern', 'ticketnumbering'),
                                    {
                                        'full_width': true,
                                        'required': true,
                                        'readonly': not can_update,
                                        'add_field_html': pattern_hint,
                                        'input_addclass': 'font-monospace',
                                        'additional_attributes': {
                                            'placeholder': default_pattern,
                                            'autocomplete': 'off',
                                            'spellcheck': 'false',
                                            'data-tn-pattern': section.itemtype
                                        }
                                    }
                                ) }}
                            </div>

                            {% if can_update %}
                                <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                                    <span class="text-secondary">{{ __('Templates:', 'ticketnumbering') }}</span>
                                    {% for preset, description in presets %}
                                        <button
                                            type="button"
                                            class="btn btn-sm btn-secondary font-monospace ticketnumbering-preset"
                                            data-tn-target="{{ section.itemtype }}"
                                            data-tn-value="{{ preset }}"
                                            title="{{ description }}"
                                        >{{ preset }}</button>
                                    {% endfor %}
                                </div>
                            {% endif %}

                            {% if section.valid_until is not empty %}
                                <div class="alert alert-warning mt-3 mb-0" role="alert">
                                    <i class="ti ti-clock-exclamation me-1"></i>
                                    {{ __('This pattern only fits into the id column until %s. After that date GLPI continues with its own numbering.', 'ticketnumbering')|format(section.valid_until) }}
                                </div>
                            {% endif %}
                        </div>

                        <div class="col-12 col-xl-5">
                            {% set status = section.status %}
                            <div class="datagrid">
                                <div class="datagrid-item">
                                    <div class="datagrid-title">{{ __('Active pattern', 'ticketnumbering') }}</div>
                                    <div class="datagrid-content font-monospace">{{ status.pattern }}</div>
                                </div>
                                <div class="datagrid-item">
                                    <div class="datagrid-title">{{ __('Next number', 'ticketnumbering') }}</div>
                                    <div class="datagrid-content">
                                        <span class="badge bg-blue-lt font-monospace fs-3">{{ status.next }}</span>
                                    </div>
                                </div>
                                {% if status.first > 0 and not status.out_of_range %}
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">{{ __('Current block', 'ticketnumbering') }}</div>
                                        <div class="datagrid-content font-monospace">{{ status.first }} – {{ status.last }}</div>
                                    </div>
                                    <div class="datagrid-item">
                                        <div class="datagrid-title">{{ __('Used in this block', 'ticketnumbering') }}</div>
                                        <div class="datagrid-content">{{ status.used_in_block }} / {{ status.block_size - 1 }}</div>
                                    </div>
                                {% endif %}
                                <div class="datagrid-item">
                                    <div class="datagrid-title">{{ __('Highest existing id', 'ticketnumbering') }}</div>
                                    <div class="datagrid-content font-monospace">{{ status.global_max }}</div>
                                </div>
                            </div>

                            {% if status.first > 0 and not status.out_of_range %}
                                {% set usage = status.block_size > 1 ? (status.used_in_block * 100 / (status.block_size - 1)) : 0 %}
                                <div class="progress progress-sm mt-3">
                                    <div
                                        class="progress-bar {{ status.exhausted ? 'bg-danger' : 'bg-blue' }}"
                                        style="width: {{ max(usage, 1)|round }}%"
                                        role="progressbar"
                                        aria-valuenow="{{ usage|round }}"
                                        aria-valuemin="0"
                                        aria-valuemax="100"
                                    ></div>
                                </div>
                            {% endif %}

                            {% if status.errors is not empty %}
                                <div class="alert alert-danger mt-3" role="alert">
                                    <i class="ti ti-alert-triangle me-1"></i>
                                    {{ __('The stored pattern is invalid; the default pattern is used until it is corrected.', 'ticketnumbering') }}
                                </div>
                            {% endif %}

                            {% if status.out_of_range %}
                                <div class="alert alert-danger mt-3" role="alert">
                                    <i class="ti ti-alert-triangle me-1"></i>
                                    {{ __('The pattern has outgrown the id column. GLPI continues with its own numbering.', 'ticketnumbering') }}
                                </div>
                            {% endif %}

                            {% if status.exhausted %}
                                <div class="alert alert-danger mt-3" role="alert">
                                    <i class="ti ti-alert-triangle me-1"></i>
                                    {{ __('This block is full. The next item will get a number outside the pattern. Increase the number of "#" digits.', 'ticketnumbering') }}
                                </div>
                            {% endif %}

                            {% if status.blocked_by_higher_id %}
                                <div class="alert alert-warning mt-3" role="alert">
                                    <i class="ti ti-alert-triangle me-1"></i>
                                    {{ __('An existing item already has a higher id than the start of this block. An id can only ever grow, so this pattern cannot take effect until the counter reaches it.', 'ticketnumbering') }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}

        {% if can_update %}
            <div class="text-end mb-3">
                <button type="submit" class="btn btn-primary" id="ticketnumbering-save">
                    <i class="ti ti-device-floppy me-1"></i>{{ __('Save') }}
                </button>
            </div>
        {% endif %}
    </form>

    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title mb-0">
                <i class="ti ti-braces me-2 text-secondary"></i>{{ __('Placeholders', 'ticketnumbering') }}
            </h3>
        </div>
        <div class="card-body pb-0">
            <p class="text-secondary">
                {{ __('A number is the numeric id of the item, so the pattern may only produce digits. Fixed digits are allowed at the beginning, date placeholders must follow from the largest to the smallest unit, and the pattern ends with the "#" counter.', 'ticketnumbering') }}
                {{ __('The counter restarts whenever the part in front of it changes — with {YY}{MM} that is every month.', 'ticketnumbering') }}
                {{ __('Tickets, problems and changes have separate counters, so the same pattern may be used for all of them.', 'ticketnumbering') }}
            </p>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <tbody>
                    {% for token, description in placeholders %}
                        <tr>
                            <td class="w-25 font-monospace">{{ token }}</td>
                            <td class="text-secondary">{{ description }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="card-footer text-secondary">
            <i class="ti ti-info-circle me-1"></i>
            {{ __('Items that are created with an explicit id — for example by an import — are never renumbered and do not move the counter.', 'ticketnumbering') }}
        </div>
    </div>
</div>

<script src="{{ path('/plugins/ticketnumbering/js/config.js') }}"></script>

{{ call('Html::footer') }}

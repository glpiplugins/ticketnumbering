#: src/Service/NumberPattern.php:229
msgid "\"{DD}\" may only be used directly after \"{MM}\"."
msgstr "\"{DD}\" darf nur direkt nach \"{MM}\" verwendet werden."

#: src/Service/NumberPattern.php:237
msgid "A pattern using a date placeholder must start with \"{YY}\" or \"{YYYY}\", otherwise the numbers would repeat every year."
msgstr "Ein Muster mit Datums-Platzhalter muss mit \"{YY}\" oder \"{YYYY}\" beginnen, sonst würden sich die Nummern jedes Jahr wiederholen."

#: templates/pages/config.html.twig:93
msgid "A ticket number is the numeric id of the ticket, so the pattern may only produce digits. Fixed digits are allowed at the beginning, date placeholders must follow from the largest to the smallest unit, and the pattern ends with the \"#\" counter."
msgstr "Eine Ticketnummer ist die numerische ID des Tickets, das Muster darf daher nur Ziffern erzeugen. Am Anfang sind feste Ziffern erlaubt, danach folgen Datums-Platzhalter von der größten zur kleinsten Einheit, am Ende steht der Zähler \"#\"."

#: templates/pages/config.html.twig:187
msgid "Active pattern"
msgstr "Aktives Muster"

#: templates/pages/config.html.twig:238
msgid "An existing ticket already has a higher id than the start of this block. A ticket id can only ever grow, so this pattern cannot take effect until the counter reaches it."
msgstr "Ein vorhandenes Ticket hat bereits eine höhere ID als der Beginn dieses Blocks. Eine Ticket-ID kann nur wachsen, dieses Muster kann daher erst greifen, wenn der Zähler sie erreicht hat."

#: templates/pages/config.html.twig:157
msgid "Click an example to copy it into the pattern field. Nothing is saved until you press Save."
msgstr "Ein Beispiel anklicken, um es in das Musterfeld zu übernehmen. Gespeichert wird erst mit „Speichern“."

#: templates/pages/config.html.twig:198
msgid "Current block"
msgstr "Aktueller Block"

#: templates/pages/config.html.twig:167
msgid "Current state"
msgstr "Aktueller Stand"

#: src/Service/NumberPattern.php:222
msgid "Date placeholders must be ordered from the largest to the smallest unit, e.g. {YY}{MM}{DD}."
msgstr "Datums-Platzhalter müssen von der größten zur kleinsten Einheit geordnet sein, z. B. {YY}{MM}{DD}."

#: templates/pages/config.html.twig:16
msgid "Define how the number of a newly created ticket is composed."
msgstr "Legt fest, wie sich die Nummer eines neu angelegten Tickets zusammensetzt."

#: templates/pages/config.html.twig:67
msgid "Example, first ticket of the current period:"
msgstr "Beispiel, erstes Ticket der aktuellen Periode:"

#: templates/pages/config.html.twig:130
msgid "Examples"
msgstr "Beispiele"

#: src/Service/NumberPattern.php:199
msgid "Fixed digits are only allowed at the beginning of the pattern."
msgstr "Feste Ziffern sind nur am Anfang des Musters erlaubt."

#: src/Service/NumberPattern.php:436
msgid "Fixed prefix 1, continuous counter (no reset)"
msgstr "Fester Präfix 1, durchlaufender Zähler (kein Reset)"

#: src/Service/NumberPattern.php:413
msgid "Four-digit year (2026)"
msgstr "Vierstelliges Jahr (2026)"

#: src/Service/NumberPattern.php:432
msgid "Four-digit year, 99999 tickets per year"
msgstr "Vierstelliges Jahr, 99999 Tickets pro Jahr"

#: templates/pages/config.html.twig:209
msgid "Highest existing ticket id"
msgstr "Höchste vorhandene Ticket-ID"

#: templates/pages/config.html.twig:191
msgid "Next ticket number"
msgstr "Nächste Ticketnummer"

#: templates/pages/config.html.twig:49
msgid "Number format"
msgstr "Nummernformat"

#: src/Service/NumberPattern.php:419
msgid "One digit of the running counter"
msgstr "Eine Stelle des laufenden Zählers"

#: src/Service/NumberPattern.php:213
msgid "Placeholder \"{%s}\" is used more than once."
msgstr "Platzhalter \"{%s}\" wird mehrfach verwendet."

#: templates/pages/config.html.twig:110
msgid "Placeholders"
msgstr "Platzhalter"

#: src/Service/NumberPattern.php:437
msgid "Plain continuous counter (GLPI default behaviour)"
msgstr "Reiner durchlaufender Zähler (Standardverhalten von GLPI)"

#: templates/pages/config.html.twig:57
msgid "Plugin numbering active"
msgstr "Plugin-Nummerierung aktiv"

#: src/Service/NumberPattern.php:415
msgid "Quarter (1-4)"
msgstr "Quartal (1-4)"

#: src/Service/NumberPattern.php:187
msgid "The \"#\" counter must be at the end of the pattern."
msgstr "Der Zähler \"#\" muss am Ende des Musters stehen."

#: src/Service/NumberPattern.php:181
msgid "The counter must be between %1$d and %2$d \"#\" long."
msgstr "Der Zähler muss zwischen %1$d und %2$d \"#\" lang sein."

#: templates/pages/config.html.twig:94
msgid "The counter restarts whenever the part in front of it changes — with {YY}{MM} that is every month."
msgstr "Der Zähler beginnt neu, sobald sich der Teil davor ändert — bei {YY}{MM} also jeden Monat."

#: src/Service/NumberPattern.php:247
msgid "The pattern can produce numbers larger than %s, which a ticket id cannot store. Use fewer digits."
msgstr "Das Muster kann Nummern größer als %s erzeugen, die eine Ticket-ID nicht speichern kann. Bitte weniger Stellen verwenden."

#: src/Service/NumberPattern.php:174
msgid "The pattern must contain a counter, written as one or more \"#\"."
msgstr "Das Muster muss einen Zähler enthalten, geschrieben als ein oder mehrere \"#\"."

#: src/Service/NumberPattern.php:176
msgid "The pattern must contain exactly one \"#\" counter block."
msgstr "Das Muster darf genau einen \"#\"-Zählerblock enthalten."

#: templates/pages/config.html.twig:27
msgid "The pattern was not saved."
msgstr "Das Muster wurde nicht gespeichert."

#: templates/pages/config.html.twig:174
msgid "The plugin numbering is switched off. New tickets keep GLPI's continuous numbering."
msgstr "Die Nummerierung des Plugins ist ausgeschaltet. Neue Tickets behalten die durchlaufende Nummerierung von GLPI."

#: templates/pages/config.html.twig:181
msgid "The stored pattern is invalid; the default pattern is used until it is corrected."
msgstr "Das gespeicherte Muster ist ungültig; bis zur Korrektur wird das Standardmuster verwendet."

#: src/Service/NumberPattern.php:88
msgid "The ticket number pattern must not be empty."
msgstr "Das Muster der Ticketnummer darf nicht leer sein."

#: templates/pages/config.html.twig:231
msgid "This block is full. The next ticket will get a number outside the pattern. Increase the number of \"#\" digits."
msgstr "Dieser Block ist voll. Das nächste Ticket erhält eine Nummer außerhalb des Musters. Bitte die Anzahl der \"#\"-Stellen erhöhen."

#: setup.php:19 src/Controller/ConfigController.php:68 templates/pages/config.html.twig:14
msgid "Ticket Numbering"
msgstr "Ticket-Nummerierung"

#: templates/pages/config.html.twig:75
msgid "Ticket number pattern"
msgstr "Muster der Ticketnummer"

#: src/Controller/ConfigController.php:53
msgid "Ticket numbering configuration saved."
msgstr "Konfiguration der Ticket-Nummerierung gespeichert."

#: templates/pages/config.html.twig:244
msgid "Tickets that are created with an explicit id — for example by an import — are never renumbered and do not move the counter."
msgstr "Tickets, die mit einer festen ID angelegt werden — etwa durch einen Import —, werden nie neu numeriert und verschieben den Zähler nicht."

#: src/Service/NumberPattern.php:417
msgid "Two-digit ISO calendar week (32)"
msgstr "Zweistellige ISO-Kalenderwoche (32)"

#: src/Service/NumberPattern.php:418
msgid "Two-digit day of month (12)"
msgstr "Zweistelliger Tag des Monats (12)"

#: src/Service/NumberPattern.php:416
msgid "Two-digit month (08)"
msgstr "Zweistelliger Monat (08)"

#: src/Service/NumberPattern.php:414
msgid "Two-digit year (26)"
msgstr "Zweistelliges Jahr (26)"

#: src/Service/NumberPattern.php:433
msgid "Two-digit year, 99999 tickets per year"
msgstr "Zweistelliges Jahr, 99999 Tickets pro Jahr"

#: src/Service/NumberPattern.php:102
msgid "Unclosed placeholder: a \"{\" has no matching \"}\"."
msgstr "Nicht geschlossener Platzhalter: zu einer \"{\" fehlt die passende \"}\"."

#: src/Service/NumberPattern.php:122
msgid "Unexpected \"}\" without a matching \"{\"."
msgstr "Unerwartete \"}\" ohne passende \"{\"."

#: src/Service/NumberPattern.php:109
msgid "Unknown placeholder \"{%s}\". Supported: %s."
msgstr "Unbekannter Platzhalter \"{%s}\". Unterstützt: %s."

#: src/Service/NumberPattern.php:149
msgid "Unsupported character \"%s\" in the pattern."
msgstr "Nicht unterstütztes Zeichen \"%s\" im Muster."

#: templates/pages/config.html.twig:202
msgid "Used in this block"
msgstr "In diesem Block verbraucht"

#: templates/pages/config.html.twig:61
msgid "When disabled, GLPI keeps its own continuous ticket numbering."
msgstr "Wenn deaktiviert, behält GLPI seine eigene durchlaufende Ticketnummerierung."

#: src/Service/NumberPattern.php:435
msgid "Year + month + day, 999 tickets per day"
msgstr "Jahr + Monat + Tag, 999 Tickets pro Tag"

#: src/Service/NumberPattern.php:431
msgid "Year + month, 99999 tickets per month (default)"
msgstr "Jahr + Monat, 99999 Tickets pro Monat (Standard)"

#: src/Service/NumberPattern.php:434
msgid "Year + quarter"
msgstr "Jahr + Quartal"
